<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Keep EF Core's SQLitePCLRaw component family on the patched 2.1 line. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regression tests are intentionally separate from the single production application. -->
    <Compile Remove="Adminbot.Tests\**" />
    <None Remove="Adminbot.Tests\**" />
    <Content Remove="Adminbot.Tests\**" />
    <EmbeddedResource Remove="Adminbot.Tests\**" />
    <EmbeddedResource Include="Assets\Fonts\NotoSans-Regular.ttf"
                      LogicalName="Adminbot.Assets.Fonts.NotoSans-Regular.ttf" />
    <None Include="Assets\Fonts\OFL.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Built-in tenant installation tutorial images. These are ordinary publish files, deliberately not embedded
         resources, so they travel to production through the normal CI publish artifact and can be inspected or replaced
         on the host without rebuilding. `Update` (not `Include`) is required: the SDK already globs these files into the
         None item group, and including them twice would produce duplicate-item build errors. Deployment refuses to
         release when any of the three tutorial directories is missing or empty from the publish output. -->
    <None Update="Assets\tutorials\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- The Telegram premium-UI emoji catalog is application content, not configuration or secret state. It must be
         present in both the build output and the publish artifact because the runtime validates it at startup and
         refuses to start on a malformed asset. `Update` (not `Include`) avoids duplicate-item errors because the SDK
         already globs these files into the None item group. -->
    <None Update="Assets\telegram-ui\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Production Data is shared state and must never be copied into an immutable release artifact. -->
    <Content Update="Data\**" CopyToPublishDirectory="Never" />
    <None Update="Data\**" CopyToPublishDirectory="Never" />
    <!-- Untracked developer scratch output (`artifacts/`, gitignored) must never enter a release artifact either. It
         holds stale copies of Data/configuration.json produced by earlier verification runs plus a redacted secrets
         dump, so publishing it would leak state into the release and trip the deployment's artifact-content preflight.
         The GitHub release is published from a clean checkout, where the directory does not exist, and the production
         host no longer publishes at all; this exclusion makes the guarantee explicit instead of incidental for anyone
         who still runs `dotnet publish` in a working copy. -->
    <Content Update="artifacts\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="artifacts\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
